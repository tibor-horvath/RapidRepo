<Project>

  <!-- Settings shared by every project in the repository. Projects may still override any of these. -->
  <PropertyGroup>
    <!-- One version for every package, bumped by release-please. CI overrides the package version with the release
         tag (-p:PackageVersion); this keeps the assembly, file and informational versions in step with it. -->
    <Version>9.4.0</Version><!-- x-release-please-version -->
    <Authors>Tibor Horváth</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Target frameworks for the runtime libraries (not the source generator, which must stay on netstandard2.0). -->
    <RapidRepoLibraryTargetFrameworks>net10.0;net11.0</RapidRepoLibraryTargetFrameworks>
    <!-- Target framework for the test projects. -->
    <RapidRepoTestTargetFramework>net11.0</RapidRepoTestTargetFramework>

    <!-- Every public and protected member of a shipped package needs XML docs; use <inheritdoc /> on members that
         implement or override a documented one. Only fires in projects with GenerateDocumentationFile. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet package metadata shared by every published package. Each project sets its own Description and adds to
       PackageTags. -->
  <PropertyGroup>
    <Copyright>Copyright (c) Tibor Horváth</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tibor-horvath/RapidRepo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tibor-horvath/RapidRepo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReleaseNotes>https://github.com/tibor-horvath/RapidRepo/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>repository;unit-of-work;uow;repository-pattern;data-access;dotnet</PackageTags>

    <!-- Symbol package (.snupkg) for nuget.org's symbol server; Source Link (built into the SDK) maps it to GitHub. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package validation baseline: the first release of the current major. Pack fails on any breaking change
         against it, so bump this only when releasing a new major version. Opted into per library project. -->
    <RapidRepoPackageValidationBaselineVersion>9.0.0</RapidRepoPackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Per-PR API check (.github/workflows/api-compat.yml): CI packs the base branch into RapidRepoApiBaselineDir
       and validates this branch's packages against those instead of the released baseline, so the check answers
       "does this PR break the public API?". A package missing from the base branch has nothing to compare with. -->
  <PropertyGroup Condition="'$(RapidRepoApiBaselineDir)' != ''">
    <RapidRepoApiBaselinePackage>$([MSBuild]::NormalizePath('$(RapidRepoApiBaselineDir)', '$(MSBuildProjectName).0.0.0-baseline.nupkg'))</RapidRepoApiBaselinePackage>
    <PackageValidationBaselinePath Condition="Exists('$(RapidRepoApiBaselinePackage)')">$(RapidRepoApiBaselinePackage)</PackageValidationBaselinePath>
    <DisablePackageBaselineValidation Condition="!Exists('$(RapidRepoApiBaselinePackage)')">true</DisablePackageBaselineValidation>
  </PropertyGroup>

</Project>
