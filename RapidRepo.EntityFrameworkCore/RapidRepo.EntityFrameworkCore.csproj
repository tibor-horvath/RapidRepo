<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RapidRepoLibraryTargetFrameworks)</TargetFrameworks>
    <PackageReadmeFile>RapidRepo.EntityFrameworkCore.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>Entity Framework Core provider for RapidRepo: generic repositories and a Unit of Work over your DbContext, with audit stamping, soft-delete query filters, optimistic concurrency and retry-safe transactions.</Description>
    <PackageTags>$(PackageTags);efcore;entity-framework-core;entityframework;orm;soft-delete;auditing</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(RapidRepoPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RapidRepo\RapidRepo.csproj" />
    <!-- UseEntityFrameworkCore<TContext>() plugs this provider into AddRapidRepo. -->
    <ProjectReference Include="..\RapidRepo.Extensions.DependencyInjection\RapidRepo.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RapidRepo.EntityFrameworkCore.Tests" />
    <None Include="..\docs\nuget\RapidRepo.EntityFrameworkCore.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
