<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RapidRepoLibraryTargetFrameworks)</TargetFrameworks>
    <PackageReadmeFile>RapidRepo.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>Provider-neutral Repository and Unit of Work contracts for .NET with built-in auditing, soft delete, optimistic concurrency, paging and transactions. No dependencies; add a provider such as RapidRepo.EntityFrameworkCore.</Description>
    <PackageTags>$(PackageTags);auditing;soft-delete;paging;optimistic-concurrency;ddd</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: interface implementations and obsolete shims are documented on the contracts, not repeated here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(RapidRepoPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RapidRepo.Tests" />
    <None Include="..\docs\nuget\RapidRepo.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
