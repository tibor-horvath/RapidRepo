<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RapidRepoLibraryTargetFrameworks)</TargetFrameworks>
    <PackageReadmeFile>RapidRepo.Extensions.DependencyInjection.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>Microsoft.Extensions.DependencyInjection integration for RapidRepo: AddRapidRepo(...) scans assemblies and registers your repositories, generic repositories and Unit of Work in one call.</Description>
    <PackageTags>$(PackageTags);dependency-injection;di;aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: interface implementations and obsolete shims are documented on the contracts, not repeated here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(RapidRepoPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RapidRepo\RapidRepo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RapidRepo.Extensions.DependencyInjection.Tests" />
    <None Include="..\docs\nuget\RapidRepo.Extensions.DependencyInjection.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
