<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RapidRepoTestTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): tests use in-memory/SQLite stores that finish
         instantly, so threading the test token through every async call adds noise without benefit. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Pinned to match RapidRepo.SourceGenerators: tests must exercise the minimum supported Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- mtp-off: run through VSTest (xunit.runner.visualstudio + coverlet.collector + coverlet.runsettings), which
         CI uses; the default xunit.v3 package switches dotnet test to Microsoft.Testing.Platform. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RapidRepo.EntityFrameworkCore\RapidRepo.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\RapidRepo.SourceGenerators\RapidRepo.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
